<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Key background -->
    <item>
        <ripple android:color="#3300D4FF">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1C232C" />
                    <corners android:radius="4dp" />
                    <stroke android:width="1dp" android:color="#2A323C" />
                </shape>
            </item>
        </ripple>
    </item>
    <!-- Subtle gray underline bar -->
    <item android:gravity="bottom" android:left="6dp" android:right="6dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="1dp" />
            <size android:height="2dp" />
        </shape>
    </item>
</layer-list>
