<?xml version="1.0" encoding="utf-8"?>
<!--
    §7.4 delayed-transcription banner — floating glass surface (visual contract:
    delayed-transcription-banner.html .banner). Dark amber-tinted glass gradient + a
    soft amber border. The 3dp amber left edge is a sibling View clipped to this shape's
    rounded outline (clipToOutline, set in DelayedTranscriptionBanner) — layer-list
    item width/gravity needs API 23 and minSdk here is 21.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#EB221E12"
        android:endColor="#EB16140E" />
    <corners android:radius="12dp" />
    <stroke android:width="1dp" android:color="#52F0B429" />
</shape>
