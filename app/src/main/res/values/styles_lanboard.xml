<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LANboardTerminalKey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">@dimen/lb_terminal_key_min_width</item>
        <item name="android:paddingStart">@dimen/lb_terminal_key_padding</item>
        <item name="android:paddingEnd">@dimen/lb_terminal_key_padding</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/lb_terminal_key_text_size</item>
        <item name="android:textColor">@color/lb_terminal_key_text</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
