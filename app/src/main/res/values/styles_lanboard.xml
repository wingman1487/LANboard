<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LANboardTerminalKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">1dp</item>
        <item name="android:layout_marginEnd">1dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/lb_terminal_key_text_size</item>
        <item name="android:textColor">@color/lb_terminal_key_text</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:background">@drawable/lb_terminal_key_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
