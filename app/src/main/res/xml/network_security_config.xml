<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- LANboard needs cleartext HTTP to reach self-hosted Whisper servers on the local network -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
